# OpenMate Environment Variables Template
# Copy this file to .env and set your credentials

# Google Gemini API Key (Primary LLM brain, Reasoning & Multimodal Analysis)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (High-Speed Whisper Voice STT, Fallback Inference & TTS)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=
